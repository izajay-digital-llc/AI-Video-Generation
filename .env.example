# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
# Secret (service-role) key. Server-only: never prefix with NEXT_PUBLIC_.
# Route handlers use it to write video rows after verifying the user.
SUPABASE_SECRET_KEY=your-secret-or-service-role-key

# Public URL of this app, used in auth emails (confirm sign-up, reset password).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# --- Video generation ---
# "luma", "fal" or "mock" (simulated, no API key needed).
# If unset: luma when LUMA_API_KEY is set, else fal when FAL_KEY is set, else mock.
VIDEO_PROVIDER=
LUMA_API_KEY=
# ray-2 (best quality) or ray-flash-2 (faster, cheaper)
LUMA_MODEL=ray-flash-2

# fal.ai — https://fal.ai/dashboard/keys
FAL_KEY=
# Any fal video model that takes `prompt` (+ `image_url`) and returns { video: { url } }.
# Defaults: Kling 2.5 Turbo Pro. Cheaper/faster alternatives are listed in the README.
FAL_TEXT_MODEL=fal-ai/kling-video/v2.5-turbo/pro/text-to-video
FAL_IMAGE_MODEL=fal-ai/kling-video/v2.5-turbo/pro/image-to-video
